{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "setpoint:block/control_desk"
      }
    },
    {
      "when": {
        "facing": "north",
        "left": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_left"
      }
    },
    {
      "when": {
        "facing": "north",
        "right": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_right"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "setpoint:block/control_desk",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "left": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_left",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "right": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_right",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "setpoint:block/control_desk",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "left": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_left",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "right": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_right",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "setpoint:block/control_desk",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "left": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_left",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "right": "false"
      },
      "apply": {
        "model": "setpoint:block/control_desk_side_right",
        "y": 270
      }
    }
  ]
}

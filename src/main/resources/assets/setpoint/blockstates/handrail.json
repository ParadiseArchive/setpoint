{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "setpoint:block/handrail_edge"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "setpoint:block/handrail_edge",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "setpoint:block/handrail_edge",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "setpoint:block/handrail_edge",
        "y": 270
      }
    },
    {
      "when": {
        "floor": "true"
      },
      "apply": {
        "model": "setpoint:block/grating"
      }
    }
  ]
}
